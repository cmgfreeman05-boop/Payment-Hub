# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Local development uses embedded PostgreSQL. Production requires postgres.
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
# DATABASE_URL=postgresql://payments:password@localhost:5432/payments

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; development generates an ephemeral value when omitted.
SESSION_SECRET=

# stripe is the real integration. demo is an explicit local-only simulator.
# Production refuses to start with PAYMENT_GATEWAY=demo.
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=